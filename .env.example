# 复制此文件为 .env 并根据需要修改

# ============================================
# MNEMOSYNE 服务配置
# ============================================

# API 地址
MNEMOSYNE_API_URL=http://127.0.0.1:8000

# API 密钥（可选）
MNEMOSYNE_API_KEY=your-api-key-here

# 数据库路径
MNEMOSYNE_DB=D:/project/MNEMOSYNE-MNS/data/memory.db
MNEMOSYNE_SHADOW_DB=D:/project/MNEMOSYNE-MNS/data/shadow.db

# ============================================
# 记忆模式（选择一个）
# ============================================

# 选项1: 全自动模式（推荐）- 自动检索和存储
MNEMOSYNE_MEMORY_MODE=experimental_global

# 选项2: 仅会话模式（默认）- 只在当前会话
# MNEMOSYNE_MEMORY_MODE=session

# ============================================
# 自动功能开关
# ============================================

# 自动检索记忆（每次对话都检索相关内容）
# 0=关闭（Hermes决定何时检索）
# 1=开启（强制每次都检索）
MNEMOSYNE_AUTO_RECALL=1

# 自动存储记忆（智能提取关键信息并保存）
# 0=关闭（不自动存储）
# 1=开启（检测到关键信息自动存储）
MNEMOSYNE_AUTO_STORE=1

# Shadow模式（跟踪记忆使用情况，用于训练V3）
# 0=关闭
# 1=开启（记录引用统计）
MNEMOSYNE_EXPERIMENTAL_SHADOW=1

# ============================================
# V3 模型配置
# ============================================

# 排序模型版本
# v3 = V3模型（推荐，使用贝叶斯统计）
# v2 = V2模型
# hybrid = 混合基线
MNEMOSYNE_RANKER_VERSION=v3

# ============================================
# 使用场景配置模板
# ============================================

# 【场景1: 全自动开发助手】（推荐）
# 适合: 日常开发，需要持续积累知识
# MNEMOSYNE_MEMORY_MODE=experimental_global
# MNEMOSYNE_AUTO_RECALL=1
# MNEMOSYNE_AUTO_STORE=1
# MNEMOSYNE_EXPERIMENTAL_SHADOW=1
# MNEMOSYNE_RANKER_VERSION=v3

# 【场景2: 按需检索】
# 适合: 临时对话，不需要保存
# MNEMOSYNE_MEMORY_MODE=session
# MNEMOSYNE_AUTO_RECALL=0
# MNEMOSYNE_AUTO_STORE=0

# 【场景3: 观察模式】
# 适合: 收集数据优化模型
# MNEMOSYNE_MEMORY_MODE=session
# MNEMOSYNE_EXPERIMENTAL_SHADOW=1
# MNEMOSYNE_RANKER_VERSION=v3

# ============================================
# 注意事项
# ============================================

# 1. 修改后需要重启Hermes才能生效
# 2. experimental_global模式会存储到全局记忆
# 3. AUTO_STORE会自动识别关键信息（"请记住"、项目状态等）
# 4. V3模型需要服务运行在8000端口
# 5. Shadow模式会将数据保存到shadow.db用于模型训练
